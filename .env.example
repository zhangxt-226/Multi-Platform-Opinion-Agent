# ============ 大模型配置（必填，任选一家 OpenAI 兼容服务） ============
# DeepSeek:   https://api.deepseek.com/v1                        + deepseek-chat
# 通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1  + qwen-plus
# 月之暗面:   https://api.moonshot.cn/v1                          + moonshot-v1-8k
# OpenAI:     留空 LLM_BASE_URL                                  + gpt-4o-mini
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# ============ 爬虫凭证（只有重新采集时才需要） ============
# 微博：登录 weibo.com 后从浏览器 F12 -> Network 里复制 Cookie 与 x-xsrf-token
WEIBO_COOKIE=
WEIBO_XSRF_TOKEN=
# 知乎：登录 zhihu.com 后复制整条 Cookie
ZHIHU_COOKIE=
# YouTube：需要代理时填写，例如 http://127.0.0.1:7897
YOUTUBE_PROXY=
